FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
WORKDIR /app
RUN pip install --no-cache-dir \
    --retries 10 \
    --timeout 120 \
    "streamlit==1.45.1" \
    "httpx==0.28.1"
COPY ui/ ./ui/
EXPOSE 8501
CMD ["streamlit","run","ui/app.py","--server.address=0.0.0.0","--server.port=8501","--browser.gatherUsageStats=false"]
